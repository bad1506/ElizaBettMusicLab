# SØNA Agent Runtime
PROMPTS_CHAT_API_URL=https://prompts.chat/api/prompts
PROMPTS_CHAT_ENABLED=true
# PROMPTS_API_KEY=pchat_...
SONA_AGENT_MAX_INPUT=12000

# Production database: Yandex Managed Service for YDB Serverless.
# Keep sqlite for local development only.
SONA_DB_PROVIDER=ydb
YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135
YDB_DATABASE=/ru-central1/<cloud>/<database>
# For local development you may point this to a service-account JSON key file.
# YDB_SERVICE_ACCOUNT_KEY_FILE_CREDENTIALS=/path/to/ydb-sa.json
YDB_TABLE_PREFIX=sona

# Durable user/audio storage: Yandex Object Storage via S3 API.
SONA_STORAGE_PROVIDER=s3
SONA_S3_ENDPOINT=https://storage.yandexcloud.net
SONA_S3_BUCKET=sona-data
SONA_S3_REGION=ru-central1
SONA_S3_ACCESS_KEY_ID=...
SONA_S3_SECRET_ACCESS_KEY=...
SONA_S3_PREFIX=sona
SONA_S3_MAX_ATTEMPTS=4
SONA_S3_HYDRATE_TTL=30

# AI provider. A real OpenAI API key is required for GPT-powered features.
# OPENAI_API_KEY=...
OPENAI_MODEL=gpt-5-mini

# Frontend/backend integration.
CORS_ORIGINS=https://your-frontend.example

# Billing: YooKassa. Keep secrets out of git.
# Payment endpoints remain disabled until both credentials are configured.
# YUKASSA_SHOP_ID=...
# YUKASSA_SECRET_KEY=...
YUKASSA_RETURN_URL=https://your-frontend.example/?payment=success
SONA_CREATOR_PRICE_RUB=990
SONA_PRO_PRICE_RUB=1990
SONA_STUDIO_PRICE_RUB=4990
# Required to call protected billing administration endpoints.
SONA_BILLING_ADMIN_KEY=...
# Optional defense-in-depth for YooKassa webhooks. Use comma-separated IPs/CIDRs.
# Keep empty if proxy topology is not yet verified. YooKassa authenticity is still checked by
# re-fetching the payment from api.yookassa.ru before activation.
YUKASSA_WEBHOOK_IP_ALLOWLIST=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.156.11,77.75.156.35,77.75.154.128/25,2a02:5180::/32
# Set true only when the service is behind a trusted reverse proxy that overwrites forwarding headers.
YUKASSA_TRUST_PROXY_HEADERS=false

# Optional integrations.
TELEGRAM_BOT_TOKEN=
HERMES_ENABLED=false
HERMES_ENDPOINT=
OPENCLAW_ENABLED=false
OPENCLAW_ENDPOINT=
