# SØNA Agent Runtime
# Public prompts.chat search works without a key.
PROMPTS_CHAT_API_URL=https://prompts.chat/api/prompts
PROMPTS_CHAT_ENABLED=true
# PROMPTS_API_KEY=pchat_...

# Optional JSONL agent-call log directory
# SONA_AGENT_LOG_DIR=/var/lib/sona/agent_logs
SONA_AGENT_MAX_INPUT=12000

# Existing SØNA/OpenAI variables remain configured in the deployment environment.
# OPENAI_API_KEY=...
# OPENAI_MODEL=

# Durable user storage. Keep local until the S3/R2 bucket is configured and tested.
SONA_STORAGE_PROVIDER=local
# SONA_DATA_DIR=/var/data/sona
# SONA_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# SONA_S3_BUCKET=sona-data
# SONA_S3_REGION=auto
# SONA_S3_ACCESS_KEY_ID=...
# SONA_S3_SECRET_ACCESS_KEY=...
# SONA_S3_PREFIX=sona
# SONA_S3_MAX_ATTEMPTS=4
# SONA_S3_HYDRATE_TTL=30

# Hermes/OpenClaw are integrated here as compatible skills, not as separate runtimes.
# Full external runtimes can be enabled later without changing the SØNA API contract.
HERMES_ENABLED=false
HERMES_ENDPOINT=
OPENCLAW_ENABLED=false
OPENCLAW_ENDPOINT=
