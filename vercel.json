{
  "buildCommand": "cd ai-engineer-ui && npm run build",
  "outputDirectory": "ai-engineer-ui/dist",
  "installCommand": "cd ai-engineer-ui && npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/public/yandex-chart",
      "destination": "/api/yandex-chart"
    },
    {
      "source": "/api/:path*",
      "destination": "https://elizabettmusiclab-1.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
