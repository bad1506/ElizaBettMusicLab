# Frontend API base URL
# Local: http://127.0.0.1:8000
# Production: https://YOUR-BACKEND-DOMAIN
VITE_API_URL=http://127.0.0.1:8000

# Telegram bot or Mini App destination
# Example: https://t.me/your_bot_username
VITE_TELEGRAM_URL=https://t.me/your_bot_username

# Backend CORS allowlist (comma-separated production frontend origins)
# Example: CORS_ORIGINS=https://eliza-bett-music-lab.vercel.app,http://localhost:5173
